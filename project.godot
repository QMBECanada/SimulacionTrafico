; Engine configuration file.
config_version=5

[application]

config/name="Simulacion de Trafico"
run/main_scene="res://Escenas/Principal.tscn"
boot_splash/bg_color=Color(0.05, 0.07, 0.12, 1)
boot_splash/image="res://Assets/portada/portada.png"
boot_splash/stretch_mode=1
boot_splash/show_image=true
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="SimulacionTrafico"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=2
